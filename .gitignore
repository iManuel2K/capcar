# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files stay private; documented templates stay versioned.
.env*
!.env.example
!.env.production.example
!.env.providers.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.capcar-backups/
supabase/.temp/
