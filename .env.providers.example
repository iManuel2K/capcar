# Capcar uses safe demo providers when these variables are absent.
CAPCAR_VEHICLE_PROVIDER_MODE=demo
CAPCAR_CATALOG_PROVIDER_MODE=demo
CAPCAR_OFFERS_PROVIDER_MODE=demo
CAPCAR_MODEL_PROVIDER_MODE=demo

# Native international parts search. App ID maps to CLIENT_ID; Cert ID maps to
# CLIENT_SECRET. Leave demo mode active until production access is confirmed.
CAPCAR_EBAY_MODE=demo
# CAPCAR_EBAY_CLIENT_ID=YOUR_EBAY_APP_ID
# CAPCAR_EBAY_CLIENT_SECRET=YOUR_EBAY_CERT_ID
# CAPCAR_EBAY_CAMPAIGN_ID=YOUR_OPTIONAL_NUMERIC_CAMPAIGN_ID

# Later, configure each licensed provider independently through a normalized
# server-side adapter endpoint. Never prefix secret keys with NEXT_PUBLIC_.
#
# CAPCAR_VEHICLE_PROVIDER_MODE=external
# CAPCAR_VEHICLE_PROVIDER_NAME=Your VIN provider
# CAPCAR_VEHICLE_PROVIDER_ENDPOINT=https://your-adapter.example/vehicle/resolve
# CAPCAR_VEHICLE_PROVIDER_API_KEY=replace-me
#
# CAPCAR_CATALOG_PROVIDER_MODE=external
# CAPCAR_CATALOG_PROVIDER_NAME=TecDoc adapter
# CAPCAR_CATALOG_PROVIDER_ENDPOINT=https://your-adapter.example/catalog/search
# CAPCAR_CATALOG_PROVIDER_API_KEY=replace-me
#
# CAPCAR_OFFERS_PROVIDER_MODE=external
# CAPCAR_OFFERS_PROVIDER_NAME=eBay adapter
# CAPCAR_OFFERS_PROVIDER_ENDPOINT=https://your-adapter.example/offers/search
# CAPCAR_OFFERS_PROVIDER_API_KEY=replace-me
#
# CAPCAR_MODEL_PROVIDER_MODE=external
# CAPCAR_MODEL_PROVIDER_NAME=Licensed BMW model library
# CAPCAR_MODEL_PROVIDER_ENDPOINT=https://your-adapter.example/models/resolve
# CAPCAR_MODEL_PROVIDER_API_KEY=replace-me
