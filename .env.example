NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEPLOYMENT_ENV=local

# Required before public launch. These values are intentionally displayed on
# the Privacy and Imprint pages.
NEXT_PUBLIC_LEGAL_OPERATOR=Your legal name or registered business
NEXT_PUBLIC_LEGAL_ADDRESS=Your complete service address
NEXT_PUBLIC_PRIVACY_CONTACT=privacy@example.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Weekly Roadbook Scout. Server-only: configure these in Netlify Functions.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
UNSPLASH_ACCESS_KEY=YOUR_UNSPLASH_ACCESS_KEY
TANKERKOENIG_API_KEY=YOUR_SERVER_ONLY_TANKERKOENIG_API_KEY
ROADBOOK_SCOUT_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Google Calendar + Gmail metadata connection. Server-only except the site URL
# above. Register this exact callback in Google Cloud:
# https://YOUR_DOMAIN/api/connections/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CONNECTION_ENCRYPTION_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS

# Closed-browser price watches. Server-only. Netlify invokes a protected
# background function from the production schedule; never expose this value.
PRICE_WATCH_JOB_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET

# Live eBay Browse API search. App ID maps to CLIENT_ID; Cert ID maps to CLIENT_SECRET.
CAPCAR_EBAY_MODE=demo
CAPCAR_EBAY_CLIENT_ID=
CAPCAR_EBAY_CLIENT_SECRET=
# Optional, only after eBay Partner Network approval.
CAPCAR_EBAY_CAMPAIGN_ID=

# Provider adapters remain on safe demo data until you sign a provider contract.
CAPCAR_VEHICLE_PROVIDER_MODE=demo
CAPCAR_CATALOG_PROVIDER_MODE=demo
CAPCAR_OFFERS_PROVIDER_MODE=demo
CAPCAR_MODEL_PROVIDER_MODE=demo
CAPCAR_COPILOT_MODE=deterministic

# Scenic-weekend planner. Deterministic mode is available without usage cost.
# Set mode to openai for web-grounded plans through the Responses API. The key
# remains server-only. Override the model only when you need a pinned alternative.
# External mode remains available for a provider-neutral JSON adapter.
CAPCAR_TRIP_PLANNER_MODE=deterministic
OPENAI_API_KEY=
CAPCAR_TRIP_PLANNER_MODEL=gpt-5.4-mini
CAPCAR_TRIP_PLANNER_ENDPOINT=
CAPCAR_TRIP_PLANNER_API_KEY=
CAPCAR_TRIP_PLANNER_PROVIDER_NAME=
