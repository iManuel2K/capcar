NEXT_PUBLIC_SITE_URL=https://capcar.example
NEXT_PUBLIC_DEPLOYMENT_ENV=production
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_LEGAL_OPERATOR=Your legal name or registered business
NEXT_PUBLIC_LEGAL_ADDRESS=Your complete service address
NEXT_PUBLIC_PRIVACY_CONTACT=privacy@example.com

# Weekly Roadbook Scout. All four values are server-only and must be scoped to
# Netlify Functions. Never prefix them with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
UNSPLASH_ACCESS_KEY=YOUR_UNSPLASH_ACCESS_KEY
ROADBOOK_SCOUT_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Live eBay Browse API. These values are server-only.
CAPCAR_EBAY_MODE=live
CAPCAR_EBAY_CLIENT_ID=YOUR_EBAY_APP_ID
CAPCAR_EBAY_CLIENT_SECRET=YOUR_EBAY_CERT_ID
# Optional after eBay Partner Network approval.
CAPCAR_EBAY_CAMPAIGN_ID=
